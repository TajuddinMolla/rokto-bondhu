rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidBloodGroup(group) {
      return group in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function isValidAvailability(status) {
      return status in ['available', 'unavailable', 'pending'];
    }

    // -------------------------------------------------------------
    // Users Collection: /users/{userId}
    // Private user account documents. Only the account owner can read or write.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && (request.resource.data.email == request.auth.token.email || request.auth.token.email == null || request.resource.data.email == '');

      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Donor Profiles Collection: /donorProfiles/{donorId}
    // Phase 10: Private to donor owner (public donor search is deferred to Phase 11).
    // Document ID strictly matches the user's Auth UID.
    // -------------------------------------------------------------
    match /donorProfiles/{donorId} {
      allow read: if isOwner(donorId);

      allow create: if isOwner(donorId)
                    && request.resource.data.userId == donorId
                    && isValidBloodGroup(request.resource.data.bloodGroup)
                    && isValidAvailability(request.resource.data.availabilityStatus);

      allow update: if isOwner(donorId)
                    && request.resource.data.userId == donorId
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && isValidBloodGroup(request.resource.data.bloodGroup)
                    && isValidAvailability(request.resource.data.availabilityStatus);

      allow delete: if isOwner(donorId);
    }

    // -------------------------------------------------------------
    // Public Donor Profiles Collection: /publicDonorProfiles/{donorId}
    // Phase 12 & 13: Dedicated public projection for open donor discovery.
    // In PRIVATE mode, phone number is strictly forbidden.
    // In PUBLIC mode, verified phone number is permitted for direct calling.
    // -------------------------------------------------------------
    match /publicDonorProfiles/{donorId} {
      // Publicly readable for volunteer discovery
      allow read: if true;

      // Only the profile owner can publish or update their public card
      allow create, update: if isOwner(donorId)
                            && (
                              // PRIVATE mode: strictly NO phone number
                              (
                                (!('contactMode' in request.resource.data) || request.resource.data.contactMode == 'PRIVATE')
                                && request.resource.data.keys().hasOnly([
                                  'displayName', 'bloodGroup', 'divisionId',
                                  'districtId', 'upazilaId', 'availabilityStatus',
                                  'lastDonationDate', 'updatedAt', 'contactMode'
                                ])
                              ) ||
                              // PUBLIC mode: donor explicitly consents to sharing phone number
                              (
                                request.resource.data.contactMode == 'PUBLIC'
                                && request.resource.data.keys().hasOnly([
                                  'displayName', 'bloodGroup', 'divisionId',
                                  'districtId', 'upazilaId', 'availabilityStatus',
                                  'lastDonationDate', 'updatedAt', 'contactMode', 'phoneNumber'
                                ])
                                && request.resource.data.phoneNumber is string
                                && request.resource.data.phoneNumber.size() >= 11
                                && request.resource.data.phoneNumber.size() <= 15
                              )
                            )
                            && isValidBloodGroup(request.resource.data.bloodGroup)
                            && isValidAvailability(request.resource.data.availabilityStatus);

      // Only the profile owner can delete their public card
      allow delete: if isOwner(donorId);
    }

    // -------------------------------------------------------------
    // Donor Contact Requests Collection: /donorContactRequests/{requestId}
    // Phase 13: Hybrid 1-to-1 donor contact and consent disclosure.
    // -------------------------------------------------------------
    match /donorContactRequests/{requestId} {
      // Readable ONLY by the recipient donor or the authenticated requester
      allow read: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid || 
        resource.data.requesterId == request.auth.uid
      );

      // Create: Authenticated requesters only.
      // Strictly prevent self-requests and prevent unauthorized initial fields.
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.donorId != request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.donorConsentGiven == false
                    && !('sharedContactDetails' in request.resource.data)
                    && request.resource.data.requesterName is string
                    && request.resource.data.requesterPhone is string
                    && request.resource.data.urgency in ['normal', 'urgent', 'critical'];

      // Update rules enforce strict role-based state machine:
      // 1. Requester can CANCEL their own PENDING request.
      // 2. Donor can ACCEPT or DECLINE a PENDING request.
      // 3. Donor can explicitly give contact consent (step 2) and attach sharedContactDetails.
      // 4. Donor or Requester can mark an ACCEPTED request as COMPLETED.
      // Neither party can alter immutable IDs or timestamps.
      allow update: if isAuthenticated()
                    && (!('donorId' in resource.data) || request.resource.data.donorId == resource.data.donorId)
                    && (!('requesterId' in resource.data) || request.resource.data.requesterId == resource.data.requesterId)
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && (
                      // Requester cancellation
                      (
                        resource.data.requesterId == request.auth.uid
                        && resource.data.status == 'PENDING'
                        && request.resource.data.status == 'CANCELLED'
                      ) ||
                      // Donor response & consent lifecycle
                      (
                        resource.data.donorId == request.auth.uid
                        && (
                          // Accept or Decline pending request
                          (resource.data.status == 'PENDING' && request.resource.data.status in ['ACCEPTED', 'DECLINED']) ||
                          // Explicit step-2 consent to share phone number
                          (resource.data.status == 'ACCEPTED' 
                            && request.resource.data.status == 'ACCEPTED'
                            && request.resource.data.donorConsentGiven == true
                            && request.resource.data.sharedContactDetails is map
                            && request.resource.data.sharedContactDetails.phoneNumber is string
                          ) ||
                          // Complete accepted request
                          (resource.data.status == 'ACCEPTED' && request.resource.data.status == 'COMPLETED')
                        )
                      )
                    );

      // Disallow hard deletion
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Blood Requests Collection: /bloodRequests/{requestId}
    // Requests created by authenticated users.
    // -------------------------------------------------------------
    match /bloodRequests/{requestId} {
      // Requesters can read their own requests.
      allow read: if isAuthenticated() && resource.data.requesterId == request.auth.uid;

      // Authenticated users can create requests for themselves with status 'open'
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && isValidBloodGroup(request.resource.data.bloodGroup)
                    && request.resource.data.unitsNeeded >= 1
                    && request.resource.data.unitsNeeded <= 20
                    && request.resource.data.urgency in ['normal', 'urgent', 'critical'];

      // Only the requester can update their request.
      // Cannot alter requesterId or createdAt.
      // Only open requests can be modified or transitioned to fulfilled/cancelled.
      allow update: if isAuthenticated()
                    && resource.data.requesterId == request.auth.uid
                    && request.resource.data.requesterId == resource.data.requesterId
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && (
                      (resource.data.status == 'open' && request.resource.data.status in ['open', 'fulfilled', 'cancelled'])
                    );

      // Hard deletion is prohibited; soft cancellation is required.
      allow delete: if false;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
