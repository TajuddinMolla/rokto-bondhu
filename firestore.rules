rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email in ['taj.unicart@gmail.com', 'admin@roktobondhu.com'] ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['ADMIN', 'admin'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          )
        )
      );
    }

    function isNotSuspended() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.suspended != true
      );
    }

    function isValidBloodGroup(group) {
      return group in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function isValidAvailability(status) {
      return status in ['available', 'unavailable', 'pending'];
    }

    // -------------------------------------------------------------
    // 1. Users Collection: /users/{userId}
    // Private user account documents. Owner or Admin have full control.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Device push tokens for FCM web push
      match /pushTokens/{tokenId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // -------------------------------------------------------------
    // 2. Donor Profiles Collection: /donorProfiles/{donorId}
    // Private donor profile details. Owner or Admin can read and write.
    // -------------------------------------------------------------
    match /donorProfiles/{donorId} {
      allow read: if isOwner(donorId) || isAdmin();
      allow create, update: if isOwner(donorId) || isAdmin();
      allow delete: if isOwner(donorId) || isAdmin();
    }

    // -------------------------------------------------------------
    // 3. Public Donor Profiles Collection: /publicDonorProfiles/{donorId}
    // Public projection for donor search and open discovery.
    // Anyone can read, only the donor or Admin can write.
    // -------------------------------------------------------------
    match /publicDonorProfiles/{donorId} {
      allow read: if true;
      allow create, update: if isOwner(donorId) || isAdmin();
      allow delete: if isOwner(donorId) || isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Donor Contact Requests Collection: /donorContactRequests/{requestId}
    // Direct 1-to-1 donor contact requests and consent management.
    // -------------------------------------------------------------
    match /donorContactRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.donorId == request.auth.uid || 
        resource.data.requesterId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Blood Requests Collection: /bloodRequests/{requestId}
    // Emergency blood requisitions.
    // -------------------------------------------------------------
    match /bloodRequests/{requestId} {
      allow read: if true;

      allow create: if isAuthenticated();

      allow update: if (
        (isAuthenticated() && (
          resource.data.requesterId == request.auth.uid &&
          (!('status' in request.resource.data) || request.resource.data.status in ['open', 'fulfilled', 'cancelled', 'expired'])
        )) ||
        isAdmin()
      );

      allow delete: if (isAuthenticated() && resource.data.requesterId == request.auth.uid) || isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Notifications Collection: /notifications/{notificationId}
    // In-app notifications.
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------
    // 7. Reports Collection: /reports/{reportId}
    // User-submitted flags on donors, blood requests, or accounts.
    // -------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. Audit Logs Collection: /auditLogs/{logId}
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
