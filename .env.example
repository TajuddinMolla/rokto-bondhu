# ==============================================================================
# RoktoBondhu — Environment Configuration Template
# Copy this file to .env.local and populate with your own project configuration.
# Never commit real credentials or .env.local to version control.
# ==============================================================================

# Site URL (Optional, for canonical links and SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web Client Configuration (Required for Firebase Authentication)
# Obtain these values from your Firebase Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Local Development Emulator (Optional)
# Set to "true" to connect Firebase Auth to the local emulator (e.g. localhost:9099)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ==============================================================================
# Transactional Email Delivery (Phase 15 - Server-side Only)
# Never expose secrets with NEXT_PUBLIC_
# If omitted or unset, system operates in Local Development Simulation mode.
# ==============================================================================

# Option 1: Resend (Recommended free tier: 3,000 emails/month, 100/day)
RESEND_API_KEY=re_your_api_key_here

# Default Email Sender Address
EMAIL_FROM="RoktoBondhu <notifications@roktobondhu.org>"

# Option 2: Generic SMTP Alternative (e.g. Brevo free tier: 300/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# ==============================================================================
# Firebase Admin SDK Configuration (Local CLI / Server Administration Only)
# Never expose secrets with NEXT_PUBLIC_ or commit keys to git.
# Required only when running local admin provisioning scripts (scripts/set-admin.mjs).
# ==============================================================================
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
